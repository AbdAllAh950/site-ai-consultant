        "url": "https://ai.api.cloud.yandex.net/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ $env.LLM_AUTH }}"
            },
            {
              "name": "OpenAI-Project",
              "value": "={{ $env.LLM_PROJECT }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: $env.LLM_SUMMARY_MODEL || $env.LLM_MODEL, temperature: 0, max_tokens: 250, messages: [ { role: 'system', content: \"Ты помощник менеджера ландшафтного бюро. Оцени заявку из чата на сайте. Верни только JSON без пояснений: {\\\"priority\\\": \\\"горячая\\\" | \\\"тёплая\\\" | \\\"холодная\\\", \\\"reason\\\": \\\"почему, до 12 слов\\\", \\\"next_step\\\": \\\"что менеджеру сделать сейчас, до 12 слов\\\"}. Горячая — хочет начать в ближайшие 2 месяца или просит выезд, замер, расчёт как можно скорее. Тёплая — есть конкретная задача, но сроки дальше или не названы. Холодная — только узнаёт цены.\" }, { role: 'user', content: 'Сегодня: ' + $now.setZone('Europe/Moscow').toFormat('dd.MM.yyyy') + '\\nЗаявка: ' + JSON.stringify({ service: $json.body.service, details: $json.body.details, budget: $json.body.budget, timeline: $json.body.timeline, summary: $json.body.summary, comment: $json.body.comment }) + '\\nПереписка:\\n' + ($json.body.dialog || []).map(m => (m.role === 'user' ? 'Клиент: ' : 'Консультант: ') + m.text).join('\\n') } ] }) }}",
        "options": {
          "timeout": 30000
        }
      }
    },
    {
      "id": "e5d2ce80-137f-4ec9-9510-6e607ce081a5",
      "name": "Строка для таблицы",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "jsCode": "// Lead from the AI chat + YandexGPT's score → one row for the sheet\nconst lead = $('Заявка из AI-чата').first().json.body;\nconst raw = $json.choices?.[0]?.message?.content ?? '';\nlet score;\ntry {\n  score = JSON.parse(raw.match(/\\{[\\s\\S]*\\}/)[0]);\n} catch (e) {\n  score = { priority: 'не оценено', reason: 'нейросеть не ответила', next_step: 'перезвонить' };\n}\nreturn [{ json: {\n  'Дата': $now.setZone('Europe/Moscow').toFormat('dd.MM.yyyy HH:mm'),\n  'Имя': lead.name,\n  'Телефон': lead.phone,\n  'Что нужно': lead.service || '',\n  'Детали': lead.details || '',\n  'Бюджет': lead.budget || '',\n  'Сроки': lead.timeline || '',\n  'Кратко': lead.summary || lead.comment || '',\n  'Приоритет': score.priority || '',\n  'Почему': score.reason || '',\n  'Следующий шаг': score.next_step || '',\n  'Язык': lead.lang || '',\n  'Страница': lead.page || '',\n} }];"
      }
    },
