# Domain of this server. No domain yet? Use the server IP with dashes: 203-0-113-5.sslip.io
DOMAIN=ai.example.ru
PUBLIC_URL=https://ai.example.ru

# YandexGPT (Yandex Cloud AI Studio, OpenAI-compatible endpoint) — works from Russia, paid in rubles
LLM_URL=https://ai.api.cloud.yandex.net/v1/chat/completions
LLM_AUTH=Api-Key ВАШ_API_КЛЮЧ
LLM_MODEL=gpt://ВАШ_FOLDER_ID/yandexgpt/latest
LLM_SUMMARY_MODEL=gpt://ВАШ_FOLDER_ID/yandexgpt-lite/latest
LLM_PROJECT=ВАШ_FOLDER_ID

# One Telegram bot for all clients (token from @BotFather); each site has its own chat id in sites/<id>/site.json
TELEGRAM_BOT_TOKEN=

# Limits and data retention
KEEP_DAYS=90
MAX_MESSAGES_PER_SESSION=40
MAX_REQUESTS_PER_MINUTE=20

# Telegram is blocked from many Russian servers: a relay URL can stand in for api.telegram.org
# TELEGRAM_API_URL=https://script.google.com/macros/s/<id>/exec?p=

# Email for leads (Yandex: smtp.yandex.ru:465 + an app password). Recipients: lead_emails in sites/<id>/site.local.json
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# MAX messenger bot (platform for partners: verified company / ИП / самозанятый). Chat: max_chat_id in site.local.json
MAX_BOT_TOKEN=

# FL.ru watcher (app/flwatch.py): new fitting projects → Telegram with a drafted reply. 0 turns it off.
# Alerts go to FL_TELEGRAM_CHAT_ID, else LEADS_TELEGRAM_CHAT_ID, else the demo site's Telegram chat.
FL_WATCH=1
# FL_TELEGRAM_CHAT_ID=
# FL_CATEGORIES=31,5,41,34,36,2   # AI, programming, automation, messengers, mobile, sites
# FL_INTERVAL=180                 # seconds between polls
# FL_DAILY_MAX=15                 # alerts per day at most
# FL_MIN_FIT=6                    # model's fit score (0–10) needed to send
