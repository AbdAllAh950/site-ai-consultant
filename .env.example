# Domain of this server. No domain yet? Use the server IP with dashes: 203-0-113-5.sslip.io
DOMAIN=ai.example.ru
PUBLIC_URL=https://ai.example.ru

# YandexGPT (Yandex Cloud AI Studio, OpenAI-compatible endpoint) — works from Russia, paid in rubles
LLM_URL=https://ai.api.cloud.yandex.net/v1/chat/completions
LLM_AUTH=Api-Key ВАШ_API_КЛЮЧ
LLM_MODEL=gpt://ВАШ_FOLDER_ID/yandexgpt/latest
LLM_SUMMARY_MODEL=gpt://ВАШ_FOLDER_ID/yandexgpt-lite/latest
LLM_PROJECT=ВАШ_FOLDER_ID

# One Telegram bot for all clients (token from @BotFather); each site has its own chat id in sites/<id>/site.json
TELEGRAM_BOT_TOKEN=

# Limits and data retention
KEEP_DAYS=90
MAX_MESSAGES_PER_SESSION=40
MAX_REQUESTS_PER_MINUTE=20
